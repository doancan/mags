{
  "name": "mags",
  "version": "0.2.1",
  "description": "Memory And Guidance System — MCP server + Claude Code plugin for project documentation and memory management",
  "type": "module",
  "author": {
    "name": "Dogancan",
    "url": "https://github.com/doancan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doancan/mags.git"
  },
  "homepage": "https://github.com/doancan/mags",
  "bugs": {
    "url": "https://github.com/doancan/mags/issues"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "documentation",
    "memory",
    "session-persistence",
    "project-management"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "cd server && npm test",
    "build": "cd server && npm run build",
    "dev": "cd server && npm run dev",
    "start": "cd server && npm start",
    "typecheck": "cd server && npm run typecheck",
    "lint": "cd server && npm run lint",
    "lint:fix": "cd server && npm run lint:fix",
    "format": "cd server && npm run format",
    "format:check": "cd server && npm run format:check",
    "prepare": "husky && cd server && npm install && npm run build && npm run bundle"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
